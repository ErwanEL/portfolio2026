---
import '../styles/global.css';
import ProjectVisual from '../components/ProjectVisual.astro';
import { projects } from '../data/projects';
import { timeline } from '../data/timeline';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Exploration de direction artistique pour le portfolio d’Erwan. Contenus de démonstration." />
    <meta name="robots" content="noindex, nofollow" />
    <title>Erwan | Portfolio / Étude 01</title>
  </head>
  <body id="haut">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="header wrap">
      <a class="wordmark" href="#haut" aria-label="Erwan, accueil">erwan<span>.</span></a>
      <span class="header-caption">Développement informatique<br />Portfolio personnel</span>
      <nav aria-label="Navigation principale">
        <a href="#projets">Projets <sup>01</sup></a>
        <a href="#parcours">Parcours <sup>02</sup></a>
        <a href="#apropos">À propos <sup>03</sup></a>
      </nav>
    </header>
    <main id="contenu" class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-index meta"><span class="square"></span> Portfolio / Étude 01 <span class="hero-edition">Édition 2026</span></div>
        <h1 id="hero-title">Des idées.<br />Du code<span class="red">.</span><br /><span class="red last-line">Du concret.<span class="hero-arrow" aria-hidden="true">↗</span></span></h1>
        <div class="hero-bottom">
          <p class="meta demo-note">Exploration graphique<br />Contenus fictifs</p>
          <div class="hero-intro"><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p><a class="text-link" href="#projets">Explorer les projets <span aria-hidden="true">↓</span></a></div>
          <span class="folio meta">(01 / 03)</span>
        </div>
      </section>
      <section id="projets" class="projects section" aria-labelledby="projects-title">
        <div class="section-heading"><span class="meta section-index">01 / Projets</span><h2 id="projects-title">Une sélection<br />de réalisations<span class="red">.</span></h2><span class="meta section-aside">Projets en cours<br />de présentation</span></div>
        <div class="project-grid">
          {projects.map((project, i) => <article class:list={['project', { 'second-project': i % 2 === 1 }]}>
            <a class="project-card-link" href={`/projets/${project.slug}/`} aria-label={`Découvrir le projet ${project.name}`}>
              <ProjectVisual {...project} />
              <div class="project-caption"><div><p class="meta">{project.index} / {project.label}</p><h3>{project.name}</h3></div><span class="project-card-arrow" aria-hidden="true">↗</span></div>
              <span class="project-open text-link">Découvrir le projet <span aria-hidden="true">→</span></span>
            </a>
          </article>)}
        </div>
      </section>
      <section id="parcours" class="section journey" aria-labelledby="journey-title">
        <div class="section-heading"><span class="meta section-index">02 / Parcours</span><h2 id="journey-title">Des premières lignes<br />aux projets d’aujourd’hui<span class="red">.</span></h2><span class="meta section-aside">2013 — 2026<br />Un parcours autodidacte</span></div>
        <ol class="timeline">
          {timeline.map((item, i) => <li class="timeline-item" data-timeline-item>
            <span class="timeline-number meta">{String(i + 1).padStart(2, '0')}</span>
            <div class="timeline-period">{item.period}</div>
            <div class="timeline-content">
              <p class="meta timeline-detail">{item.detail}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              {item.parallel && <aside class="timeline-parallel">
                <p class="meta">{item.parallel.period}</p>
                <h4>{item.parallel.title}</h4>
                <p>{item.parallel.text}</p>
              </aside>}
            </div>
          </li>)}
        </ol>
      </section>
      <section id="apropos" class="section about" aria-labelledby="about-title">
        <div class="about-sidebar">
          <span class="meta section-index">03 / À propos</span>
          <figure class="portrait">
            <div class="portrait-placeholder">
              <span class="meta">Portrait</span>
              <span class="portrait-initial" aria-hidden="true">e.</span>
              <span class="meta">Photo à venir</span>
            </div>
            <figcaption class="meta">Erwan / Présentation</figcaption>
          </figure>
        </div>
        <div><h2 id="about-title">Le sens du détail.<br />La vue d’ensemble<span class="red">.</span></h2><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p><p class="meta about-note">Texte de présentation à venir.</p></div>
      </section>
    </main>
    <footer class="wrap footer"><a class="wordmark" href="#haut">erwan<span>.</span></a><span class="meta">Portfolio / 2026 / Maquette de direction artistique</span><a class="text-link" href="#haut">Retour en haut <span aria-hidden="true">↑</span></a></footer>
    <script>
      const items = document.querySelectorAll('[data-timeline-item]');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('timeline-motion');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.2 });
        items.forEach((item) => observer.observe(item));
      }
    </script>
  </body>
</html>

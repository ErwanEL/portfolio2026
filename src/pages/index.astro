---
import '../styles/global.css';
const years = [
  { year: '2026', title: 'Lorem ipsum dolor', detail: 'Projet en cours · Exemple', text: 'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer vitae justo eget magna fermentum iaculis.' },
  { year: '2024', title: 'Consectetur adipiscing', detail: 'Expérience · Exemple', text: 'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.' },
  { year: '2022', title: 'Ut enim ad minim', detail: 'Premiers projets · Exemple', text: 'Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.' },
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Exploration de direction artistique pour le portfolio d’Erwan. Contenus de démonstration." />
    <meta name="robots" content="noindex, nofollow" />
    <title>Erwan — Portfolio / Étude 01</title>
  </head>
  <body id="haut">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="header wrap">
      <a class="wordmark" href="#haut" aria-label="Erwan, accueil">erwan<span>.</span></a>
      <span class="header-caption">Développement informatique<br />Portfolio personnel</span>
      <nav aria-label="Navigation principale">
        <a href="#projets">Projets <sup>01</sup></a>
        <a href="#parcours">Parcours <sup>02</sup></a>
        <a href="#apropos">À propos <sup>03</sup></a>
      </nav>
    </header>
    <main id="contenu" class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-index meta"><span class="square"></span> Portfolio — Étude 01 <span class="hero-edition">Édition 2026</span></div>
        <h1 id="hero-title">Des idées.<br />Du code<span class="red">.</span><br /><span class="red last-line">Du concret.<span class="hero-arrow" aria-hidden="true">↗</span></span></h1>
        <div class="hero-bottom">
          <p class="meta demo-note">Exploration graphique<br />Contenus fictifs</p>
          <div class="hero-intro"><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p><a class="text-link" href="#projets">Explorer les projets <span aria-hidden="true">↓</span></a></div>
          <span class="folio meta">(01 — 03)</span>
        </div>
      </section>
      <section id="projets" class="projects section" aria-labelledby="projects-title">
        <div class="section-heading"><span class="meta section-index">01 / Projets</span><h2 id="projects-title">Une sélection<br />de réalisations<span class="red">.</span></h2><span class="meta section-aside">Deux projets fictifs<br />pour poser le cadre</span></div>
        <div class="project-grid">
          <article class="project">
            <div class="project-visual visual-one" aria-label="Composition typographique de démonstration pour le projet Lorem">
              <div class="visual-top meta"><span>Étude digitale / 001</span><span>2026</span></div>
              <div class="specimen">lo<span>r</span>em<span class="specimen-dot">.</span></div>
              <div class="visual-bottom meta"><span>Clarté. Structure. Interface.</span><span aria-hidden="true">↗</span></div>
            </div>
            <div class="project-caption"><div><p class="meta">01 — Application web</p><h3>Lorem ipsum</h3></div><span class="meta">2026</span></div>
            <details><summary>À propos de ce projet <span aria-hidden="true">+</span></summary><p>Projet fictif. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p></details>
          </article>
          <article class="project second-project">
            <div class="project-visual visual-two" aria-label="Composition typographique de démonstration pour le projet Ipsum">
              <div class="visual-top meta"><span>Expérience web / 002</span><span>2024</span></div>
              <div class="specimen second-specimen">ip<span class="outline">sum</span><span class="asterisk" aria-hidden="true">✳</span></div>
              <div class="visual-bottom meta"><span>Un autre point de vue.</span><span aria-hidden="true">↗</span></div>
            </div>
            <div class="project-caption"><div><p class="meta">02 — Plateforme digitale</p><h3>Dolor sit amet</h3></div><span class="meta">2024</span></div>
            <details><summary>À propos de ce projet <span aria-hidden="true">+</span></summary><p>Projet fictif. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p></details>
          </article>
        </div>
      </section>
      <section id="parcours" class="section journey" aria-labelledby="journey-title">
        <div class="section-heading"><span class="meta section-index">02 / Parcours</span><h2 id="journey-title">Au fil<br />des années<span class="red">.</span></h2><span class="meta section-aside">Chronologie illustrative<br />Dates et expériences fictives</span></div>
        <div class="timeline">{years.map((item, i) => <details class="timeline-item" open={i === 0}><summary><span class="year">{item.year}</span><span class="timeline-title">{item.title}<span class="meta">{item.detail}</span></span><span class="toggle" aria-hidden="true">+</span></summary><p>{item.text}</p></details>)}</div>
      </section>
      <section id="apropos" class="section about" aria-labelledby="about-title">
        <div class="about-sidebar">
          <span class="meta section-index">03 / À propos</span>
          <figure class="portrait">
            <div class="portrait-placeholder">
              <span class="meta">Portrait</span>
              <span class="portrait-initial" aria-hidden="true">e.</span>
              <span class="meta">Photo à venir</span>
            </div>
            <figcaption class="meta">Erwan / Présentation</figcaption>
          </figure>
        </div>
        <div><h2 id="about-title">Le sens du détail.<br />La vue d’ensemble<span class="red">.</span></h2><p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.</p><p class="meta about-note">Texte de présentation à venir.</p></div>
      </section>
    </main>
    <footer class="wrap footer"><a class="wordmark" href="#haut">erwan<span>.</span></a><span class="meta">Portfolio / 2026 — Maquette de direction artistique</span><a class="text-link" href="#haut">Retour en haut <span aria-hidden="true">↑</span></a></footer>
  </body>
</html>
